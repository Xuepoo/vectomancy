<!-- prettier-ignore -->
<!-- eslint-disable -->
<!DOCTYPE html>
<html>
<head>
    <title>Vectomancy Output</title>
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #333; display: flex; justify-content: center; align-items: center; }
        canvas { background: #fff; max-width: 100%; max-height: 100vh; object-fit: contain; box-shadow: 0 0 10px rgba(0,0,0,0.5); }
    </style>
</head>
<body>
    <canvas id="canvas" width="{{ width | default(value=4000) }}" height="{{ height | default(value=4000) }}"></canvas>
    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');

        {% if equations %}
        {% for path in equations %}
        {% if path.color_rgb %}
        ctx.strokeStyle = `rgb({{ path.color_rgb.0 }}, {{ path.color_rgb.1 }}, {{ path.color_rgb.2 }})`;
        {% else %}
        ctx.strokeStyle = 'rgb(0, 0, 0)';
        {% endif %}
        {% for eq in path.data %}
        ctx.beginPath();
        {
            let first = true;
            const steps = Math.min(10000, Math.max(1, Math.ceil(({{ eq.end_t }} - {{ eq.start_t }}) / 0.01)));
            for (let i = 0; i <= steps; i++) {
                const t = {{ eq.start_t }} + ({{ eq.end_t }} - {{ eq.start_t }}) * i / steps;
                let x = {{ eq.x_expression_js }}{% if has_x_offset %} - {{ bbox_min_x }}{% endif %};
                let y = {{ eq.y_expression_js }}{% if has_y_offset %} - {{ bbox_min_y }}{% endif %};
                if (first) {
                    ctx.moveTo(x, y);
                    first = false;
                } else {
                    ctx.lineTo(x, y);
                }
            }
        }
        ctx.stroke();
        {% endfor %}
        {% endfor %}
        {% elif strokes %}
        {% for stroke_path in strokes %}
        {% if stroke_path.color_rgb %}
        ctx.strokeStyle = `rgb({{ stroke_path.color_rgb.0 }}, {{ stroke_path.color_rgb.1 }}, {{ stroke_path.color_rgb.2 }})`;
        {% else %}
        ctx.strokeStyle = 'rgb(0, 0, 0)';
        {% endif %}
        ctx.beginPath();
        {
            let first = true;
            const steps = 629;
            for (let i = 0; i <= steps; i++) {
                const t = Math.PI * 2 * i / steps;
                let x = {{ stroke_path.x_expression_js }}{% if has_x_offset %} - {{ bbox_min_x }}{% endif %};
                let y = {{ stroke_path.y_expression_js }}{% if has_y_offset %} - {{ bbox_min_y }}{% endif %};
                if (first) {
                    ctx.moveTo(x, y);
                    first = false;
                } else {
                    ctx.lineTo(x, y);
                }
            }
        }
        ctx.stroke();
        {% endfor %}
        {% elif paths %}
        {% for path in paths %}
        {% if path.color_rgb %}
        ctx.strokeStyle = `rgb({{ path.color_rgb.0 }}, {{ path.color_rgb.1 }}, {{ path.color_rgb.2 }})`;
        {% else %}
        ctx.strokeStyle = 'rgb(0, 0, 0)';
        {% endif %}
        ctx.beginPath();
        {% for p in path.data %}
        {% if loop.first %}ctx.moveTo({{ p.x }}{% if has_x_offset %} - {{ bbox_min_x }}{% endif %}, {{ p.y }}{% if has_y_offset %} - {{ bbox_min_y }}{% endif %});{% else %}ctx.lineTo({{ p.x }}{% if has_x_offset %} - {{ bbox_min_x }}{% endif %}, {{ p.y }}{% if has_y_offset %} - {{ bbox_min_y }}{% endif %});{% endif %}
        {% endfor %}
        ctx.stroke();
        {% endfor %}
        {% endif %}
    </script>
</body>
</html>
